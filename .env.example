# NEPSE Sense Configuration

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Database
DB_URL=sqlite:///./nepse_sense.db

# Scheduler
TIMEZONE=Asia/Kathmandu

# Trading calendar / market session
# TRADING_DAYS: Python weekday numbers Mon=0..Sun=6, or names (sun,mon,...).
# Default Mon-Fri. VERIFY against NEPSE — set sun,mon,tue,wed,thu for the
# historical NEPSE calendar.
TRADING_DAYS=0,1,2,3,4
SESSION_OPEN=11:00
SESSION_CLOSE=15:00
DATA_GRACE_MINUTES=30

# Data Sources
ENABLE_EXPERIMENTAL_LIVE=false
# MeroLagani index adapter. Keep false: the site's Terms prohibit automated
# collection (docs/DATA_SOURCES.md §8). Use `import-index-csv` instead.
ENABLE_MEROLAGANI=false

# Alerts
ALERTS_POST_CLOSE_TIME=15:45

# Network
USER_AGENT=nepse-sense/0.1.0 (+https://github.com/yourusername/nepse-sense)
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3
