# NEPSE Sense Configuration

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Database
DB_URL=sqlite:///./nepse_sense.db

# Scheduler
TIMEZONE=Asia/Kathmandu

# Data Sources
ENABLE_EXPERIMENTAL_LIVE=false

# Alerts
ALERTS_POST_CLOSE_TIME=15:45

# Network
USER_AGENT=nepse-sense/0.1.0 (+https://github.com/yourusername/nepse-sense)
REQUEST_TIMEOUT=30
REQUEST_RETRIES=3
